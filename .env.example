# =====================================================
# TTHCM AI Platform - Production environment template
# Copy to .env on the VPS and fill real values.
# =====================================================

# Server
NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# Public app URL, no trailing slash.
# Example: https://hoc-tthcm.example.com
APP_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com
APP_NAME=TTHCM AI

# JWT
# Use a long random value, at least 32 characters.
# Example command: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# LowDB storage
# Keep production data outside the repo so deploys do not overwrite it.
DB_PATH=/var/www/tthcm-ai/data/tthcm.json

# Demo user
# Keep false in production. Set true only for staging/demo.
SEED_DEMO_USER=false

# Dify AI API
# Typical API URL: https://api.dify.ai/v1
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=replace-with-dify-app-api-key
DIFY_CONVERSATION_MODE=chat

# Google OAuth
# Authorized redirect URI:
# https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
